{
  "name": "imaxnearme.com",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "cf dev",
    "build": "npm run check:fetch-venues && tsc -b && cf build",
    "lint": "eslint .",
    "preview": "vite preview",
    "deploy": "npm run build && npm run deploy:production",
    "deploy:production": "node --env-file-if-exists=.env scripts/deploy-production.mjs",
    "preview:cf": "cf dev",
    "fetch-venues": "bash scripts/fetch-imax-venues.sh",
    "check:fetch-venues": "npm run types && tsc -p tsconfig.worker.json",
    "test:fetch-venues": "node --test worker/*.test.ts",
    "refresh-venues": "cf workflows instances create imaxnearme-venues",
    "upload-venues": "bash scripts/safe-r2-upload.sh imaxnearme-data/imax-venues.json imax-venues.json",
    "upload-cache": "bash scripts/safe-r2-upload.sh imaxnearme-data/theatre-details.json theatre-details.json",
    "download-cache": "bash scripts/download-r2.sh imaxnearme-data/theatre-details.json theatre-details.json",
    "upload-imax-cache": "bash scripts/safe-r2-upload.sh imaxnearme-data/imax-urls.json imax-urls.json",
    "download-imax-cache": "bash scripts/download-r2.sh imaxnearme-data/imax-urls.json imax-urls.json",
    "deploy:preview": "npm run check:fetch-venues && tsc -b && node scripts/deploy-preview.mjs",
    "test": "npm run test:fetch-venues && node --test scripts/*.test.mjs",
    "types": "cf workers types"
  },
  "dependencies": {
    "maplibre-gl": "^5.19.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-map-gl": "^8.1.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.sha-52b0dc0e9",
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "cf": "^1.0.0-beta.12",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1"
  },
  "engines": {
    "node": ">=24"
  }
}
